# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ═══════════════════════════════════════════════════════════════════════════════
# META CLOUD API (provider principal — use este se tiver número via Meta)
# ═══════════════════════════════════════════════════════════════════════════════
WA_PROVIDER=meta

# Token de acesso permanente gerado em:
#   Meta Developers → Seu App → WhatsApp → Configuração da API → Gerar token
META_ACCESS_TOKEN=EAAXZCsX495II...

# Phone Number ID exibido na mesma tela de Configuração da API
META_PHONE_NUMBER_ID=123456789012345

# Token de verificação do webhook (você escolhe qualquer string secreta)
META_VERIFY_TOKEN=b2if_verify_2025

# Versão da Graph API (não altere salvo se a Meta deprecar)
META_API_VERSION=v20.0

# ─── Evolution API (alternativa — deixe em branco se usar Meta) ──────────────
# WA_PROVIDER=evolution
# EVOLUTION_API_URL=https://your-evolution.server.com
# EVOLUTION_API_KEY=your-evolution-api-key
# EVOLUTION_INSTANCE=b2if

# ─── Z-API (alternativa — deixe em branco se usar Meta) ──────────────────────
# WA_PROVIDER=zapi
# ZAPI_INSTANCE_ID=your-instance-id
# ZAPI_TOKEN=your-token
# ZAPI_CLIENT_TOKEN=your-client-token

# ─── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Configurações de IA ───────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
