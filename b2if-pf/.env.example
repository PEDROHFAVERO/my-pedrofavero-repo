# ═══════════════════════════════════════════════════════════════════════════════
# Planejador PF — Variáveis de Ambiente  (White Label — Modelo C)
#
# Como usar:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha cada variável com os dados do cliente
#   3. Coloque o logo do cliente em public/ (ex: public/logo-cliente.png)
#   4. Execute:  npm run build
#   5. Faça o deploy da pasta dist/ no Netlify / Vercel / Cloudflare Pages
#
# ATENÇÃO: nunca commite o arquivo .env com credenciais reais.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────────────────
# Encontre em: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...sua_anon_key_aqui...

# ── Identidade visual (White Label) ───────────────────────────────────────────
# Nome principal exibido no header, login e documentos PDF
VITE_APP_NAME=Nome da Empresa PF

# Subtítulo exibido na tela de login abaixo do logo
VITE_APP_SUBTITLE=Planejador Financeiro

# Nome da empresa (rodapé da tela de login)
VITE_APP_COMPANY=Nome da Empresa

# Tagline (ex: "Sistema de Uso Interno" ou "Área do Cliente")
VITE_APP_TAGLINE=Sistema de Uso Interno

# ── Cor da marca ───────────────────────────────────────────────────────────────
# Hex sem aspas. As variantes escura/clara são calculadas automaticamente.
# Exemplos:
#   Teal (padrão): #00B8A9
#   Azul:          #1A56DB
#   Roxo:          #7C3AED
#   Verde:         #059669
#   Vermelho:      #DC2626
VITE_BRAND_COLOR=#00B8A9

# ── Logo ───────────────────────────────────────────────────────────────────────
# Nome do arquivo de logo dentro da pasta public/
# Formatos suportados: PNG, SVG, WebP
# Tamanho recomendado: 128×128 px ou maior (quadrado)
VITE_LOGO_FILE=logo-light.png
